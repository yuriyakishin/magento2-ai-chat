<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="yu_aichat_conversation" resource="default" engine="innodb" comment="AI Chat Conversations">
        <column xsi:type="int" name="conversation_id" unsigned="true" nullable="false" identity="true" comment="Conversation ID"/>
        <column xsi:type="varchar" name="uuid" length="36" nullable="false" comment="Public UUID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" comment="Customer ID"/>
        <column xsi:type="varchar" name="guest_token" length="32" nullable="true" comment="Guest Token"/>
        <column xsi:type="varchar" name="channel" length="16" nullable="false" default="web" comment="Channel"/>
        <column xsi:type="varchar" name="external_id" length="64" nullable="true" comment="External Channel ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="locale" length="8" nullable="true" comment="Locale"/>
        <column xsi:type="varchar" name="title" length="255" nullable="true" comment="Title"/>
        <column xsi:type="varchar" name="provider" length="32" nullable="true" comment="AI Provider"/>
        <column xsi:type="varchar" name="model" length="64" nullable="true" comment="AI Model"/>
        <column xsi:type="varchar" name="topic" length="32" nullable="true" comment="Classified Topic"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="conversation_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="YU_AICHAT_CONVERSATION_UUID">
            <column name="uuid"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="YU_AICHAT_CONVERSATION_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="yu_aichat_conversation" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="YU_AICHAT_CONVERSATION_STORE_ID_STORE_STORE_ID"
                    table="yu_aichat_conversation" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
        <index referenceId="YU_AICHAT_CONVERSATION_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
        <index referenceId="YU_AICHAT_CONVERSATION_GUEST_TOKEN" indexType="btree">
            <column name="guest_token"/>
        </index>
        <index referenceId="YU_AICHAT_CONVERSATION_TOPIC" indexType="btree">
            <column name="topic"/>
        </index>
    </table>
    <table name="yu_aichat_message" resource="default" engine="innodb" comment="AI Chat Messages">
        <column xsi:type="int" name="message_id" unsigned="true" nullable="false" identity="true" comment="Message ID"/>
        <column xsi:type="int" name="conversation_id" unsigned="true" nullable="false" comment="Conversation ID"/>
        <column xsi:type="varchar" name="role" length="16" nullable="false" comment="Role"/>
        <column xsi:type="text" name="content" nullable="false" comment="Content"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="complete" comment="Status"/>
        <column xsi:type="int" name="prompt_tokens" unsigned="true" nullable="true" comment="Prompt Tokens"/>
        <column xsi:type="int" name="completion_tokens" unsigned="true" nullable="true" comment="Completion Tokens"/>
        <column xsi:type="int" name="total_tokens" unsigned="true" nullable="true" comment="Total Tokens"/>
        <column xsi:type="decimal" name="cost" scale="6" precision="12" nullable="true" comment="Estimated Cost"/>
        <column xsi:type="int" name="latency_ms" unsigned="true" nullable="true" comment="Processing Time (ms)"/>
        <column xsi:type="varchar" name="provider" length="32" nullable="true" comment="AI Provider"/>
        <column xsi:type="varchar" name="model" length="64" nullable="true" comment="AI Model"/>
        <column xsi:type="varchar" name="page_type" length="32" nullable="true" comment="Page Type"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="true" comment="Context Product ID"/>
        <column xsi:type="int" name="category_id" unsigned="true" nullable="true" comment="Context Category ID"/>
        <column xsi:type="varchar" name="url" length="1024" nullable="true" comment="Page URL"/>
        <column xsi:type="varchar" name="referrer" length="1024" nullable="true" comment="Referrer URL"/>
        <column xsi:type="smallint" name="customer_group_id" unsigned="true" nullable="true" comment="Customer Group ID"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="message_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="YU_AICHAT_MESSAGE_CONV_ID_YU_AICHAT_CONVERSATION_CONV_ID"
                    table="yu_aichat_message" column="conversation_id"
                    referenceTable="yu_aichat_conversation" referenceColumn="conversation_id" onDelete="CASCADE"/>
        <index referenceId="YU_AICHAT_MESSAGE_CONVERSATION_ID" indexType="btree">
            <column name="conversation_id"/>
        </index>
        <index referenceId="YU_AICHAT_MESSAGE_PRODUCT_ID" indexType="btree">
            <column name="product_id"/>
        </index>
        <index referenceId="YU_AICHAT_MESSAGE_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
    <table name="yu_aichat_system_task" resource="default" engine="innodb" comment="AI Chat System/Background Task Runs">
        <column xsi:type="int" name="task_id" unsigned="true" nullable="false" identity="true" comment="Task Run ID"/>
        <column xsi:type="varchar" name="task" length="32" nullable="false" comment="Task Name"/>
        <column xsi:type="varchar" name="provider" length="32" nullable="true" comment="AI Provider"/>
        <column xsi:type="varchar" name="model" length="64" nullable="true" comment="AI Model"/>
        <column xsi:type="int" name="prompt_tokens" unsigned="true" nullable="true" comment="Prompt Tokens"/>
        <column xsi:type="int" name="completion_tokens" unsigned="true" nullable="true" comment="Completion Tokens"/>
        <column xsi:type="decimal" name="cost" scale="6" precision="12" nullable="true" comment="Estimated Cost"/>
        <column xsi:type="int" name="items_processed" unsigned="true" nullable="true" comment="Items Processed"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" comment="Status"/>
        <column xsi:type="text" name="error_message" nullable="true" comment="Error Message"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="task_id"/>
        </constraint>
        <index referenceId="YU_AICHAT_SYSTEM_TASK_TASK" indexType="btree">
            <column name="task"/>
        </index>
        <index referenceId="YU_AICHAT_SYSTEM_TASK_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
